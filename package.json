{
  "name": "wp-api-tools",
  "version": "0.1.0",
  "description": "Interactive CLI to discover and query any WordPress site's REST API",
  "type": "module",
  "bin": {
    "wp-api-tools": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node18 --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wordpress/url": "^5.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "flat": "^6.0.1",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
